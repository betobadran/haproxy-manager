# Gerenciado pelo Ansible
HAPM_MANAGER_URL={{ hapm_manager_url }}
HAPM_JOIN_TOKEN={{ hapm_join_token }}
HAPM_NODE_NAME={{ inventory_hostname }}
HAPM_NODE_INTERFACE={{ hapm_node_interface }}
HAPM_NODE_ADDRESS={{ hapm_node_address | default(ansible_host) }}
HAPM_RELOAD_MODE=systemd
HAPM_RELOAD_COMMAND=systemctl reload-or-restart haproxy
HAPM_KEEPALIVED_RELOAD_COMMAND=systemctl reload-or-restart keepalived
HAPM_METRICS_PORT=9101
HAPM_METRICS_HOST=127.0.0.1
