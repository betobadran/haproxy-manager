{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AcmListar",
      "Effect": "Allow",
      "Action": [
        "acm:ListCertificates",
        "acm:ListTagsForCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AcmPedirSomenteComTagHapm",
      "Effect": "Allow",
      "Action": "acm:RequestCertificate",
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:RequestTag/hapm-cluster": "false"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "hapm-cluster",
            "hapm-certificate"
          ]
        }
      }
    },
    {
      "Sid": "AcmTagSomenteNaCriacao",
      "Effect": "Allow",
      "Action": "acm:AddTagsToCertificate",
      "Resource": "arn:aws:acm:*:*:certificate/*",
      "Condition": {
        "Null": {
          "aws:RequestTag/hapm-cluster": "false",
          "aws:ResourceTag/hapm-cluster": "true"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "hapm-cluster",
            "hapm-certificate"
          ]
        }
      }
    },
    {
      "Sid": "AcmDescreverExportarSomenteCertificadosHapm",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:ExportCertificate"
      ],
      "Resource": "arn:aws:acm:*:*:certificate/*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/hapm-cluster": "false"
        }
      }
    },
    {
      "Sid": "Route53ValidacaoDns",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName",
        "route53:GetChange"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53SomenteRegistrosDeValidacaoAcm",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "CNAME"
          ],
          "route53:ChangeResourceRecordSetsActions": [
            "UPSERT"
          ]
        },
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "_*"
          ]
        }
      }
    }
  ]
}
