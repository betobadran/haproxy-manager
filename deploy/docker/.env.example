# Copie para .env e preencha. NÃO versione o .env (ele está no .gitignore).

# Nome pelo qual usuários e nós acessam o manager
MANAGER_DOMAIN=hapm.exemplo.com.br

# TLS do proxy (Caddy):
#   vazio                                          -> Let's Encrypt automático (domínio público, porta 80 acessível)
#   tls internal                                   -> CA própria do Caddy (rede interna; distribua a CA aos nós)
#   tls /certs/fullchain.pem /certs/privkey.pem    -> seu certificado, em ./certs
MANAGER_TLS=

# Segredos (gere com: openssl rand -base64 48)
HAPM_DB_PASSWORD=
HAPM_SECRET=
# Senha do admin inicial; vazia = aleatória, exibida no log do primeiro start (docker compose logs manager)
HAPM_ADMIN_PASSWORD=

# Em que IP do host cada porta escuta. O Docker ignora o firewall do host (ufw/firewalld) para portas publicadas:
# use o IP da rede de administração para a interface e o da rede dos nós para agentes/ACME.
# UI_BIND=10.0.0.5
# AGENTS_BIND=10.10.0.5
# ACME_BIND=10.10.0.5
# HTTP_BIND=10.0.0.5

# Portas publicadas no host (opcional)
# HTTP_PORT=80
# UI_PORT=443
# AGENTS_PORT=8443
# ACME_PORT=8088

# Tag da imagem e memória da JVM (opcional)
# HAPM_IMAGE_TAG=0.1.0
# HAPM_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
