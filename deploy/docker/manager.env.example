# Variáveis extras do manager (opcional). Copie para manager.env; ele é lido pelo serviço "manager".
# Referência: docs/autenticacao.md, docs/alertas.md, docs/aws-acesso.md.

# LDAP / Active Directory
# HAPM_LDAP_ENABLED=true
# HAPM_LDAP_URL=ldaps://ad.exemplo.com:636
# ...

# OIDC / SSO
# HAPM_OIDC_ENABLED=true
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_HAPM_CLIENT_ID=haproxy-manager
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_HAPM_CLIENT_SECRET=...
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_HAPM_ISSUERURI=https://sso.exemplo.com/realms/empresa

# AWS (ACM/Route 53): prefira a role da instância/task; chaves fixas não são recomendadas
# AWS_REGION=sa-east-1

# Busca de logs de acesso (Loki)
# HAPM_LOKI_URL=http://loki:3100
