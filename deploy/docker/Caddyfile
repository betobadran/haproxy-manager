# Proxy TLS do manager. As variáveis vêm do .env (ver .env.example).
# MANAGER_TLS: vazio = certificado automático (Let's Encrypt; o domínio precisa ser público e a porta 80 acessível),
#              "tls internal" = CA própria do Caddy, ou "tls /certs/fullchain.pem /certs/privkey.pem" = seu certificado.
# HTTP -> HTTPS sempre para a interface (sem isto o Caddy poderia redirecionar para a porta dos agentes)
http://{$MANAGER_DOMAIN} {
	redir https://{host}{uri} permanent
}

# Interface e API (rede de administração)
{$MANAGER_DOMAIN} {
	{$MANAGER_TLS}
	encode gzip
	reverse_proxy manager:8080
}

# Agentes (rede dos nós): só /agent/**
{$MANAGER_DOMAIN}:8443 {
	{$MANAGER_TLS}
	handle /agent/* {
		reverse_proxy manager:8081
	}
	handle {
		respond 404
	}
}

# Desafio ACME dos listeners: os nós repassam /.well-known/acme-challenge/ para cá em HTTP
# (configure "Manager visto pelo HAProxy" = <host do manager>:8088 no cluster)
http://:8088 {
	handle /.well-known/acme-challenge/* {
		reverse_proxy manager:8081
	}
	handle {
		respond 404
	}
}
