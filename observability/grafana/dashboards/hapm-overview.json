      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "type": "timeseries",
      "title": "Tráfego por nó (req/s) — onde está o VIP",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (hapm_node) (rate(haproxy_frontend_http_requests_total{hapm_cluster=~\"$cluster\",hapm_node=~\"$node\",proxy!~\"hapm_.*\"}[$__rate_interval]))",
          "legendFormat": "{{hapm_node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "type": "timeseries",
      "title": "Bytes/s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (proxy) (rate(haproxy_frontend_bytes_in_total{hapm_cluster=~\"$cluster\",hapm_node=~\"$node\",proxy!~\"hapm_.*\"}[$__rate_interval]))",
          "legendFormat": "in {{proxy}}",
          "refId": "A"
        },
        {
