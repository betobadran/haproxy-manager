# /etc/hapm/agent.env  (chmod 600)
HAPM_MANAGER_URL=https://hapm.example.internal
HAPM_JOIN_TOKEN=<cluster-id>.<segredo>   # copiado da tela do cluster no manager
HAPM_NODE_NAME=lb1
# IP usado no unicast do VRRP (padrão: primeiro IPv4 da interface abaixo)
HAPM_NODE_INTERFACE=eth0
#HAPM_NODE_ADDRESS=192.168.10.11

# Como recarregar o HAProxy: systemd (padrão) | master-socket | command
HAPM_RELOAD_MODE=systemd
HAPM_RELOAD_COMMAND=systemctl reload-or-restart haproxy
#HAPM_MASTER_SOCKET=/run/haproxy-master.sock
HAPM_KEEPALIVED_RELOAD_COMMAND=systemctl reload-or-restart keepalived

HAPM_METRICS_PORT=9101
# CA própria para o manager (TLS com CA interna): importe no truststore do Java, ex.:
#JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/etc/hapm/truststore.jks
