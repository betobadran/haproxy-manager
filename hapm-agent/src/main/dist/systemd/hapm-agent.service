[Unit]
Description=HAPM agent (gerência de HAProxy/Keepalived)
After=network-online.target haproxy.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/hapm/agent.env
ExecStartPre=/usr/bin/node /opt/hapm-agent/src/index.js --bootstrap
ExecStart=/usr/bin/node /opt/hapm-agent/src/index.js
Restart=always
RestartSec=3
# precisa de root para recarregar haproxy/keepalived e gravar em /etc
User=root
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
