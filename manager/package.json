{
  "name": "hapm-manager",
  "version": "0.1.0",
  "description": "HAPM - HAProxy HA Manager (control plane: API, UI, render de configs, deploy e ACME)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "dev": "HAPM_DATA_DIR=./data HAPM_ADMIN_PASSWORD=admin node --no-warnings --watch src/index.js",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "acme-client": "^5.4.0",
    "fastify": "^5.4.0"
  }
}
